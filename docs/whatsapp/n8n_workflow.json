    "Baseera Inbound (Image)": { "main": [ [ { "node": "Send Reply (Meta)", "type": "main", "index": 0 } ] ] },
    "Baseera Inbound (Text)": { "main": [ [ { "node": "Send Reply (Meta)", "type": "main", "index": 0 } ] ] }
